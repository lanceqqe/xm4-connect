<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>XM4 Connect</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="background.png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background.png" alignment="bottomleft" scaling="none"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="app.xm4connect.mac"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="app.xm4connect.mac" visible="false">
        <pkg-ref id="app.xm4connect.mac"/>
    </choice>
    <pkg-ref id="app.xm4connect.mac" onConclusion="none">XM4Connect-component.pkg</pkg-ref>
</installer-gui-script>
