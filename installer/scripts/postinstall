#!/bin/sh
# Open the app for the logged-in user (the installer itself runs as root).
user=$(/usr/bin/stat -f%Su /dev/console)
if [ -n "$user" ] && [ "$user" != "root" ] && [ "$user" != "loginwindow" ]; then
    uid=$(/usr/bin/id -u "$user")
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/open -a "/Applications/XM Connect.app" --args --open || true
fi
exit 0
